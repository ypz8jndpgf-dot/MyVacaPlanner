# Optional: Upstash Redis storage. If unset, the app uses a local JSON
# file store at data/db.json (zero-config local runs).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Organizer Pass (ships dark — leave ALL of these unset until launch).
# MVP_PASS_ENABLED=1 turns the feature on; checkout additionally needs
# the secret key of MyVacaPlanner's own Stripe account (created by the
# owner under the LLC at enable time), and the webhook needs its
# signing secret.
MVP_PASS_ENABLED=
MVP_STRIPE_SECRET_KEY=
MVP_STRIPE_WEBHOOK_SECRET=
